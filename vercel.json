{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client"
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/((?!assets/).*)",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    }
  ]
}
